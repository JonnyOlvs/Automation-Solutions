# Copiar a backend/.env para desarrollo local (o configurar estas variables
# como "Environment variables" en el servicio de hosting, ej. Render).

# Puerto local. En Render se ignora: Render inyecta PORT automaticamente.
BACKEND_PORT=4000

# --- Cloudflare R2 (storage de evidencias generadas por GitHub Actions) ---
# Dejar todas vacias/comentadas para desarrollo 100% local (el backend sigue
# funcionando solo con los datos mock + la carpeta evidencias/ local).
#
# Se obtienen en Cloudflare > R2 > Manage API tokens (token con permiso de
# LECTURA sobre el bucket es suficiente para el backend).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=automation-solutions-evidencias
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Dominio propio conectado al bucket (Cloudflare > R2 > bucket > Settings > Custom Domains)
# R2_PUBLIC_BASE_URL=https://evidencias.automatedsolutionsgroup.org

# Cada cuanto se refresca la lista de ejecuciones de CI desde R2 (ms)
# CI_EVIDENCE_POLL_MS=30000
