{
  "name": "automation-solutions-backend",
  "version": "1.0.0",
  "description": "API del Dashboard de QA Automation (Automated Solutions) - capa de datos por repositorio, reemplazable por PostgreSQL sin tocar rutas/servicios",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate:mock": "node scripts/generate-mock.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
